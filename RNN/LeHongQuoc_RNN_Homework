ext/plain":["<Figure size 800x400 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["import torch\n","import torch.nn as nn\n","from torch.utils.data import DataLoader, TensorDataset\n","from sklearn.preprocessing import MinMaxScaler\n","\n","# -----------------------------------------\n","# PHẦN A: TIỀN XỬ LÝ\n","# -----------------------------------------\n","# 1. Chia tỉ lệ dữ liệu (70% Train, 15% Val, 15% Test)\n","n = len(df)\n","train_end = int(n * 0.7)\n","val_end = int(n * 0.85)\n","\n","train_df = df.iloc[:train_end]\n","val_df = df.iloc[train_end:val_end]\n","test_df = df.iloc[val_end:]\n","\n","# 2. Chuẩn hoá dữ liệu [0, 1] (Chỉ fit trên Train)\n","features = ['feature_1', 'feature_2', 'feature_3']\n","target_col = ['target']\n","\n","scaler_X = MinMaxScaler()\n","scaler_y = MinMaxScaler()\n","\n","# Fit và Transform trên Train\n","train_X_scaled = scaler_X.fit_transform(train_df[features])\n","train_y_scaled = scaler_y.fit_transform(train_df[target_col])\n","\n","# Chỉ Transform trên Val và Test\n","val_X_scaled = scaler_X.transform(val_df[features])\n","val_y_scaled = scaler_y.transform(val_df[target_col])\n","\n","test_X_scaled = scaler_X.transform(test_df[features])\n","test_y_scaled = scaler_y.transform(test_df[target_col])\n","\n","# 3. Hàm tạo cửa sổ trượt (Sliding Window)\n","def create_sequences(X, y, seq_length):\n","    X_seq, y_seq = [], []\n","    for i in range(len(X) - seq_length):\n","        X_seq.append(X[i : i+seq_length])\n","        y_seq.append(y[i+seq_length])\n","    return torch.tensor(X_seq, dtype=torch.float32), torch.tensor(y_seq, dtype=torch.float32)\n","\n","seq_length = 20\n","\n","X_train, y_train = create_sequences(train_X_scaled, train_y_scaled, seq_length)\n","X_val, y_val = create_sequences(val_X_scaled, val_y_scaled, seq_length)\n","X_test, y_test = create_sequences(test_X_scaled, test_y_scaled, seq_length)\n","\n","# Tạo DataLoader\n","train_loader = DataLoader(TensorDataset(X_train, y_train), batch_size=16, shuffle=False)\n","val_loader = DataLoader(TensorDataset(X_val, y_val), batch_size=16, shuffle=False)\n","\n","# -----------------------------------------\n","# PHẦN B: MÔ HÌNH VÀ HUẤN LUYỆN\n","# -----------------------------------------\n","class MultiVariateRNN(nn.Module):\n","    def __init__(self, input_size, hidden_size, output_size, num_layers=1, dropout=0.0):\n","        super().__init__()\n","        self.rnn = nn.RNN(input_size, hidden_size, num_layers, batch_first=True, dropout=dropout)\n","        self.fc = nn.Linear(hidden_size, output_size)\n","\n","    def forward(self, x):\n","        # x shape: (batch, seq_len, input_size)\n","        out, h_n = self.rnn(x)\n","        # Lấy output ở bước thời gian cuối cùng\n","        last_out = out[:, -1, :]\n","        return self.fc(last_out)\n","\n","model = MultiVariateRNN(input_size=3, hidden_size=32, output_size=1)\n","criterion = nn.MSELoss()\n","optimizer = torch.optim.Adam(model.parameters(), lr=0.01)\n","\n","epochs = 150\n","train_losses, val_losses = [], []\n","\n","for epoch in range(epochs):\n","    model.train()\n","    batch_train_loss = 0\n","    for batch_X, batch_y in train_loader:\n","        optimizer.zero_grad()\n","        outputs = model(batch_X)\n","        loss = criterion(outputs, batch_y)\n","        loss.backward()\n","        optimizer.step()\n","        batch_train_loss += loss.item()\n","\n","    train_losses.append(batch_train_loss / len(train_loader))\n","\n","    # Validation\n","    model.eval()\n","    with torch.no_grad():\n","        val_preds = model(X_val)\n","        val_loss = criterion(val_preds, y_val)\n","        val_losses.append(val_loss.item())\n","\n","# Vẽ đồ thị Loss\n","plt.figure(figsize=(8, 4))\n","plt.plot(train_losses, label='Train Loss')\n","plt.plot(val_losses, label='Val Loss')\n","plt.title('Training & Validation Loss')\n","plt.legend()\n","plt.show()"]},{"cell_type":"markdown","source":["# TODO: Phần B — định nghĩa và train mô hình"],"metadata":{"id":"PdlzrgIXF3QS"}},{"cell_type":"code","source":["from sklearn.metrics import mean_squared_error, mean_absolute_error\n","\n","# Đánh giá mô hình\n","model.eval()\n","with torch.no_grad():\n","    test_preds_scaled = model(X_test).numpy()\n","\n","# Un-normalize về miền giá trị gốc\n","test_preds = scaler_y.inverse_transform(test_preds_scaled)\n","test_y_true = scaler_y.inverse_transform(y_test.numpy())\n","\n","# Baseline Naive: Dự đoán y_t = y_{t-1} (trong tập test)\n","# Ở đây ta lấy target ở bước cuối cùng của mỗi sequence làm dự đoán cho bước tiếp theo\n","naive_preds_scaled = X_test[:, -1, -1].unsqueeze(1).numpy() # -1 cuối cùng giả định target có tương quan mạnh với feature cuối,\n","                                                            # NHƯNG đúng chuẩn thì baseline lấy chính target thật ở t-1.\n","# Cách đúng nhất cho naive:\n","naive_preds_true = test_df['target'].iloc[seq_length-1 : -1].values\n","\n","# Tính Metrics\n","mse_model = mean_squared_error(test_y_true, test_preds)\n","mae_model = mean_absolute_error(test_y_true, test_preds)\n","\n","mse_naive = mean_squared_error(test_y_true, naive_preds_true)\n","\n","print(f\"Model MSE: {mse_model:.4f} | MAE: {mae_model:.4f}\")\n","print(f\"Naive Baseline MSE: {mse_naive:.4f}\")\n","\n","# Vẽ biểu đồ\n","plt.figure(figsize=(10, 4))\n","plt.plot(test_y_true, label='True Target', color='blue')\n","plt.plot(test_preds, label='RNN Predictions', color='red', linestyle='--')\n","plt.plot(naive_preds_true, label='Naive Baseline', color='green', alpha=0.5)\n","plt.title('Dự báo tập Test: RNN vs Baseline')\n","plt.legend()\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":426},"id":"6EvKS_I_FIKC","executionInfo":{"status":"ok","timestamp":1779711835661,"user_tz":-420,"elapsed":184,"user":{"displayName":"Hồng Quốc","userId":"11757425768062241486"}},"outputId":"0418b23f-07f0-488e-8807-9b49a1577a68"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["Mod